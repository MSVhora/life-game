# Copy to .env (gitignored) and fill in. Placeholders only.

# Public URL of the app (https in production; the session cookie is "secure" when this starts with https).
PUBLIC_URL=https://life.example.com
APP_PORT=3000
# Who can reach the app port. 127.0.0.1 = this machine only (use this behind nginx).
# 0.0.0.0 = anyone on your network, for trying it from a phone at home.
APP_BIND=127.0.0.1

# Postgres (used by docker-compose; DATABASE_URL is assembled from these).
POSTGRES_USER=life
POSTGRES_PASSWORD=change-me
POSTGRES_DB=life

# Generate with: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Generate with: cd server && npm run hash-password   (paste the whole ADMIN_PASSWORD_HASH=... line)
ADMIN_PASSWORD_HASH=

# Optional: push reminders. Generate with: cd server && npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: time tracker (Solidtime) API, read-only use. Leave empty to turn the freelance meter off.
# URL is the API base, e.g. https://time.yourdomain.tld/api . ORG_ID is optional (looked up if empty).
TIMETRACKER_API_URL=
TIMETRACKER_API_TOKEN=
TIMETRACKER_ORG_ID=

# Backups (scripts/backup.sh): an rclone remote path, e.g. gdrive:life-game-backups
BACKUP_TARGET=gdrive:life-game-backups
BACKUP_KEEP_DAYS=30
