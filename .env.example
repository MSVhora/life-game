# Copy to .env (gitignored) and fill in. Placeholders only.

# Public URL of the app (https in production; the session cookie is "secure" when this starts with https).
PUBLIC_URL=https://life.example.com
APP_PORT=3000

# Postgres (used by docker-compose; DATABASE_URL is assembled from these).
POSTGRES_USER=life
POSTGRES_PASSWORD=change-me
POSTGRES_DB=life

# Generate with: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Generate with: cd server && npm run hash-password   (paste the whole ADMIN_PASSWORD_HASH=... line)
ADMIN_PASSWORD_HASH=

# Optional: time tracker (Solidtime) API, read-only use
TIMETRACKER_API_URL=https://time.example.com/api
TIMETRACKER_API_TOKEN=change-me

# Backups (scripts/backup.sh): an rclone remote path, e.g. gdrive:life-game-backups
BACKUP_TARGET=gdrive:life-game-backups
BACKUP_KEEP_DAYS=30
